@startuml casos_de_uso
left to right direction
skinparam shadowing false
actor "Usuário" as Usuario
actor Aluno
actor Professor
actor "Empresa parceira" as Empresa
Aluno --|> Usuario
Professor --|> Usuario
Empresa --|> Usuario
rectangle "Sistema de Moeda Estudantil" as Sistema {
  usecase "Realizar login" as UC01
  usecase "Manter cadastro de aluno" as UC02
  usecase "Manter cadastro de empresa" as UC03
  usecase "Enviar moedas" as UC04
  usecase "Consultar extrato" as UC05
  usecase "Manter vantagens" as UC06
  usecase "Resgatar vantagem" as UC07
  usecase "Conferir e utilizar cupom" as UC08
}
Usuario --> UC01
Aluno --> UC02
Empresa --> UC03
Professor --> UC04
Aluno --> UC05
Professor --> UC05
Empresa --> UC06
Aluno --> UC07
Empresa --> UC08
note bottom of Sistema
Cadastro inicial público para aluno e empresa.
Operações privadas exigem sessão e perfil autorizado.
Regras e efeitos estão nos critérios das histórias.
end note
@enduml
