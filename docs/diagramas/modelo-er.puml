@startuml modelo_er
hide circle
skinparam linetype ortho
skinparam shadowing false
entity instituicao_ensino {
  id BIGINT  <<PK>>
  nome VARCHAR(150) NOT NULL UNIQUE
}
entity usuario {
  id BIGINT  <<PK>>
  nome VARCHAR(120) NOT NULL
  email VARCHAR(180) NOT NULL UNIQUE
  senha_hash VARCHAR(100) NOT NULL
  ativo BOOLEAN NOT NULL DEFAULT TRUE
}
entity aluno {
  id BIGINT <<PK>> <<FK>> usuario(id)
  cpf VARCHAR(11) NOT NULL UNIQUE
  rg VARCHAR(30) NOT NULL
  endereco VARCHAR(250) NOT NULL
  curso VARCHAR(120) NOT NULL
  saldo INTEGER NOT NULL DEFAULT 0 CHECK (saldo >= 0)
  instituicao_id BIGINT NOT NULL <<FK>> instituicao_ensino(id)
}
usuario ||--o{ aluno
instituicao_ensino ||--o{ aluno
entity professor {
  id BIGINT <<PK>> <<FK>> usuario(id)
  cpf VARCHAR(11) NOT NULL UNIQUE
  departamento VARCHAR(120) NOT NULL
  saldo INTEGER NOT NULL DEFAULT 0 CHECK (saldo >= 0)
  instituicao_id BIGINT NOT NULL <<FK>> instituicao_ensino(id)
}
usuario ||--o{ professor
instituicao_ensino ||--o{ professor
entity empresa_parceira {
  id BIGINT <<PK>> <<FK>> usuario(id)
}
usuario ||--o{ empresa_parceira
entity vantagem {
  id BIGINT  <<PK>>
  empresa_id BIGINT NOT NULL <<FK>> empresa_parceira(id)
  descricao VARCHAR(500) NOT NULL
  custo INTEGER NOT NULL CHECK (custo > 0)
  foto BLOB NOT NULL
  foto_tipo VARCHAR(30) NOT NULL
  ativa BOOLEAN NOT NULL DEFAULT TRUE
}
empresa_parceira ||--o{ vantagem
entity transacao {
  id BIGINT  <<PK>>
  data TIMESTAMP NOT NULL
  quantidade INTEGER NOT NULL CHECK (quantidade > 0)
}
entity envio_moeda {
  id BIGINT <<PK>> <<FK>> transacao(id)
  professor_id BIGINT NOT NULL <<FK>> professor(id)
  aluno_id BIGINT NOT NULL <<FK>> aluno(id)
  motivo VARCHAR(1000) NOT NULL CHECK (LENGTH(TRIM(motivo)) > 0)
}
transacao ||--o{ envio_moeda
professor ||--o{ envio_moeda
aluno ||--o{ envio_moeda
entity troca_vantagem {
  id BIGINT <<PK>> <<FK>> transacao(id)
  aluno_id BIGINT NOT NULL <<FK>> aluno(id)
  vantagem_id BIGINT NOT NULL <<FK>> vantagem(id)
  codigo VARCHAR(36) NOT NULL UNIQUE
  descricao_vantagem VARCHAR(500) NOT NULL
  utilizada_em TIMESTAMP
}
transacao ||--o{ troca_vantagem
aluno ||--o{ troca_vantagem
vantagem ||--o{ troca_vantagem
entity credito_semestral {
  id BIGINT <<PK>> <<FK>> transacao(id)
  professor_id BIGINT NOT NULL <<FK>> professor(id)
  semestre VARCHAR(6) NOT NULL
  UNIQUE (professor_id, semestre)
}
transacao ||--o{ credito_semestral
professor ||--o{ credito_semestral
entity notificacao {
  id BIGINT  <<PK>>
  transacao_id BIGINT NOT NULL <<FK>> transacao(id)
  destinatario VARCHAR(180) NOT NULL
  assunto VARCHAR(200) NOT NULL
  texto VARCHAR(3000) NOT NULL
  enviada_em TIMESTAMP
  tentativas INTEGER NOT NULL DEFAULT 0
}
transacao ||--o{ notificacao
note bottom of usuario
PK das subclasses também é FK de usuario (JOINED).
Email é único entre todos os perfis.
end note
@enduml
